   ],
   [
    "وَمَا شَرُّ الثَّلاَثَةِ أُمَّ عَمْرٍو",
    "بِصَاحِبِكِ الذِي لاَ تَصْبَحِينَا"
   ],
   [
    "وَكَأْسٍ قَدْ شَرِبْتُ بِبَعْلَبَكٍّ",
    "وَأُخْرَى فِي دِمَشْقَ وَقَاصرِينَا"
   ],
   [
