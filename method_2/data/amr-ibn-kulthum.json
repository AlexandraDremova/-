    "رَوَادِفُهَا تَنوءُ بِمَا وَلِيْنَا"
   ],
   [
    "وَمأْكَمَةً يَضِيقُ البَابُ عَنْهَا",
    "وكَشْحاً قَد جُنِنْتُ بِهِ جُنُونَا"
